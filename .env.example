# Resend (https://resend.com) — enquiries are only logged if any of these are unset.
RESEND_API_KEY=
# Each submission emails a confirmation to the person who sent it, BCCing this address
ENQUIRY_BCC_EMAIL=matt@mjsmithholdings.co.uk
# Where their replies go (optional)
ENQUIRY_REPLY_TO_EMAIL=hello@cadvero.com
# Must be on a domain verified in Resend
ENQUIRY_FROM_EMAIL="Cadvero <enquiries@cadvero.com>"
